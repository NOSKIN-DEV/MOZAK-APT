{
  "name": "apt-eventos",
  "version": "0.1.0",
  "private": true,
  "description": "APT - Plataforma de descubrimiento de entretenimiento y actividades (prototipo/MVP)",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "check:data": "tsx scripts/check-mock-data.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "docker:mock": "docker compose up --build",
    "docker:postgres": "docker compose -f docker-compose.yml -f docker-compose.postgres.yml up --build"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "next": "16.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "16.4.1",
    "@eslint/eslintrc": "3.2.0",
    "tailwindcss": "4.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "postcss": "8.4.49",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "prisma": "^6.16.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
