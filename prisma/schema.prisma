// Esquema Prisma de MOZAK (APT) — Etapa 11 (persistencia PostgreSQL).
//
// Refleja el "Modelo físico" del documento «Modelo de Datos». Las tablas y
// columnas de la base usan snake_case (@@map / @map) mientras que el código
// TypeScript sigue usando camelCase, igual que el tipo `Event` de src/types.
//
// Lo que Prisma NO modela y vive solo en la migración SQL:
//   - extensiones `postgis` y `unaccent`
//   - restricciones CHECK (precio/gratuidad, fechas, formato de afiche/video,
//     rangos de latitud/longitud)
// La columna `location geography(Point, 4326)` de `venue` se agrega junto con
// la historia de búsqueda por proximidad (HU-25), no en esta etapa.
//
// Las migraciones se escriben a mano (prisma/migrations/*/migration.sql) y se
// aplican con `prisma migrate deploy`.
//
// Etapa 15 (migración 0002_roles_moderacion): usuarios con rol (ADMIN/CREATOR),
// estado de publicación de cada evento y auditoría de las decisiones de
// moderación. El consumidor NO tiene cuenta: solo existen administradores y
// creadores. Lo que Prisma no modela y vive solo en el SQL de la migración: las
// restricciones CHECK (correo en minúsculas, un evento de creador no puede estar
// publicado sin fecha de revisión, una aprobación exige la lista confirmada).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CREATOR

  @@map("user_role")
}

/// Ciclo de vida de un evento. Solo PUBLISHED es visible en la API pública.
enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED

  @@map("event_status")
}

enum ReviewDecision {
  APPROVED
  REJECTED
  UNPUBLISHED

  @@map("review_decision")
}

/// Administrador o creador. La tabla se llama app_user porque "user" es palabra reservada en PostgreSQL.
model User {
  id           String    @id
  /// Siempre en minúsculas (restricción CHECK en la migración).
  email        String    @unique
  name         String
  /// Hash scrypt de la contraseña (nunca la contraseña). Ver src/lib/auth/password.ts.
  passwordHash String    @map("password_hash")
  role         UserRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)

  events  Event[]
  reviews ModerationReview[]

  @@map("app_user")
}

/// Decisión de un administrador sobre un evento (auditoría). Solo se agregan filas, no se editan.
model ModerationReview {
  id                 String         @id
  eventId            String         @map("event_id")
  reviewerId         String         @map("reviewer_id")
  decision           ReviewDecision
  /// Motivo (ADULT_CONTENT, DRUGS, BLACK_MARKET, OTHER_NORM, INCOMPLETE_INFO); null al aprobar.
  reasonCategory     String?        @map("reason_category")
  note               String?
  /// Categorías que marcó el cribado automático al momento de decidir.
  flaggedCategories  String[]       @default([]) @map("flagged_categories")
  /// true si el administrador confirmó la lista de condiciones de la norma.
  checklistConfirmed Boolean        @map("checklist_confirmed")
  policyVersion      String         @map("policy_version")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewer User  @relation(fields: [reviewerId], references: [id])

  @@index([eventId], map: "moderation_review_event_idx")
  @@index([reviewerId], map: "moderation_review_reviewer_idx")
  @@map("moderation_review")
}

model Category {
  id          String  @id
  name        String
  description String
  /// Orden de presentación en el filtro (el mock lo daba por el orden del arreglo).
  sortOrder   Int     @default(0) @map("sort_order")
  events      Event[]

  @@map("category")
}

model Venue {
  id        String  @id
  name      String
  address   String
  commune   String
  city      String
  latitude  Float
  longitude Float
  events    Event[]

  @@map("venue")
}

model Source {
  id           String  @id
  name         String
  organization String
  type         String
  url          String
  apiUrl       String? @map("api_url")
  active       Boolean @default(true)
  events       Event[]

  @@map("source")
}

model Event {
  id             String   @id
  externalId     String?  @map("external_id")
  title          String
  description    String
  categoryId     String   @map("category_id")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  startTime      DateTime @map("start_time") @db.Time(0)
  endTime        DateTime @map("end_time") @db.Time(0)
  /// Precio en pesos chilenos (CLP), sin decimales.
  price          Int
  isFree         Boolean  @map("is_free")
  imageUrl       String?  @map("image_url")
  posterImageUrl String?  @map("poster_image_url")
  videoUrl       String?  @map("video_url")
  sourceUrl      String   @map("source_url")
  sourceId       String   @map("source_id")
  venueId        String   @map("venue_id")

  /// Etapa 15. Por seguridad, un evento nuevo NO nace publicado: la semilla y la
  /// aprobación de un administrador son las únicas vías a PUBLISHED. Los eventos
  /// que ya existían al migrar quedaron PUBLISHED (ver 0002_roles_moderacion).
  status                  EventStatus @default(DRAFT)
  /// Creador del evento; null en los eventos de demostración cargados por la semilla.
  createdById             String?     @map("created_by_id")
  submittedAt             DateTime?   @map("submitted_at") @db.Timestamptz(3)
  reviewedAt              DateTime?   @map("reviewed_at") @db.Timestamptz(3)
  /// Cuándo el creador declaró que el evento cumple la política de contenido.
  contentPolicyAcceptedAt DateTime?   @map("content_policy_accepted_at") @db.Timestamptz(3)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category           @relation(fields: [categoryId], references: [id])
  source   Source             @relation(fields: [sourceId], references: [id])
  venue    Venue              @relation(fields: [venueId], references: [id])
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reviews  ModerationReview[]

  @@index([categoryId], map: "event_category_idx")
  @@index([venueId], map: "event_venue_idx")
  @@index([sourceId], map: "event_source_idx")
  @@index([startDate, endDate], map: "event_dates_idx")
  @@index([status], map: "event_status_idx")
  @@index([createdById], map: "event_created_by_idx")
  @@map("event")
}
