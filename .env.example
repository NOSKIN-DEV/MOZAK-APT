# ---------------------------------------------------------------------------
# Variables de entorno del prototipo APT
# Copiar este archivo como .env.local y completar según el entorno local.
# NUNCA commitear el archivo .env.local ni credenciales reales.
#
# Para el modo PostgreSQL local copia estas mismas dos variables también en un
# archivo ".env" (sin ".local"): la CLI de Prisma solo lee ".env", mientras que
# Next.js lee ambos.
# ---------------------------------------------------------------------------

# Fuente de datos activa: "mock" (por defecto en el prototipo) o "postgres"
DATA_SOURCE=mock

# --- PostgreSQL + PostGIS (Etapa 11) ---
# Solo se usa con DATA_SOURCE=postgres. Estos valores coinciden con el servicio
# "db" de docker-compose.postgres.yml (credenciales de DESARROLLO LOCAL).
# DATABASE_URL="postgresql://mozak:mozak_dev@localhost:5432/mozak?schema=public"

# --- Servidor de prueba gratuito: Neon + Vercel (Etapa 14) ---
# Ver docs/DESPLIEGUE.md. Las cadenas de conexión de Neon son CONTRASEÑAS:
# se pegan en las variables de entorno de Vercel o en la consola, nunca en un
# archivo versionado ni en un chat.

# --- Perfiles de creador y administrador (Etapa 15) ---
# El público general NO tiene cuenta: solo consulta eventos publicados.
# Estas variables son para los paneles /creador y /admin.
#
# Firma de las sesiones: texto largo y aleatorio (mínimo 32 caracteres), por
# ejemplo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si falta se usa un secreto temporal (solo sirve en UNA instancia local: las
# sesiones se pierden al reiniciar). En Vercel o con varias instancias es obligatoria.
# SESSION_SECRET=

# Cuentas de DEMOSTRACIÓN en modo mock (admin@mozak.demo / organizador@mozak.demo).
# Con "npm run dev" se crean solas; en producción solo con ENABLE_DEMO_USERS=true.
# La contraseña por defecto está escrita en el README: NO las actives en un
# servidor accesible desde Internet.
# ENABLE_DEMO_USERS=true
# DEMO_USERS_PASSWORD=

# Semilla de PostgreSQL (npm run db:seed): crea el administrador real si defines
# estas dos variables (contraseña de mínimo 10 caracteres). Son contraseñas:
# se pegan en la consola o en las variables del servidor, nunca en un archivo versionado.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# Cuentas de demostración también en la base (solo para uso local):
# SEED_DEMO_USERS=true
